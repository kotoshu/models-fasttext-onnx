# Tier binaries/vocabs ARE committed (LFS objects) since plan 92 — they
# mirror to media.githubusercontent.com, the CORS-fetchable host browsers
# use — and remain release assets as well. tiers.json and eval/reports
# are committed as before.

# Nested (2D-Matryoshka) single-artifact experiment (plan 71).
# The full-vocab int8 .onnx is a binary release asset — never committed.
# The small .nested.json truncation manifest IS committed.
models/**/*.nested.onnx

# int4-group128 full-vocab experiment (plan 68 B1).
# Binary + copied full vocab are local-only release-size artifacts;
# eval/reports/int4.*.json ARE committed.
models/**/*.int4.onnx
models/**/*.int4.vocab.json

# int4 lever-retry sweep + mixed mini-at-int4 (plan 68 B1 follow-up).
# Same rule: binaries local-only, eval/reports/int4-*.{lang}.json committed.
models/**/*.int4-g*.onnx
models/**/*.int4-g*.vocab.json
models/**/*.int4-mini.onnx
models/**/*.int4-mini.vocab.json
