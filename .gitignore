# Active ONNX model directories — only these are tracked.
# To promote a language: validate it end-to-end with Kotoshu.correct?,
# then remove its line from the negation block below and `git add`.
models/*/
!models/de/
!models/en/
!models/es/
!models/fr/
!models/ja/
!models/ko/
!models/pt/
!models/ru/
!models/zh/

# Generated tier binaries/vocabs — release assets only, never committed.
# tiers.json and eval/reports ARE committed.
models/**/*.mini.onnx
models/**/*.fluency.onnx
models/**/*.mini.vocab.json
models/**/*.fluency.vocab.json

# Nested (2D-Matryoshka) single-artifact experiment (plan 71).
# The full-vocab int8 .onnx is a binary release asset — never committed.
# The small .nested.json truncation manifest IS committed.
models/**/*.nested.onnx

# int4-group128 full-vocab experiment (plan 68 B1).
# Binary + copied full vocab are local-only release-size artifacts;
# eval/reports/int4.*.json ARE committed.
models/**/*.int4.onnx
models/**/*.int4.vocab.json
