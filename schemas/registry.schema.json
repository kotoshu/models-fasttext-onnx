{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kotoshu/models-fasttext-onnx/raw/main/schemas/registry.schema.json",
  "title": "Kotoshu resource registry (Resource Spec v1)",
  "description": "Shape of registry.json, generated by scripts/build_registry.py. The spec value kotoshu.resources/v1 is frozen; content changes bump release_tag, never resource ids.",
  "type": "object",
  "required": [
    "spec",
    "registry_version",
    "generated_at",
    "release_tag",
    "resources"
  ],
  "properties": {
    "spec": {
      "const": "kotoshu.resources/v1"
    },
    "registry_version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "resources": {
      "type": "object",
      "propertyNames": {
        "pattern": "^kotoshu://(models/(lid/lid-176|[a-z]{2}/(full|fluency|mini|buckets))|packs/[a-z]{2})$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/resource"
          },
          {
            "$ref": "#/$defs/pack"
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "type",
        "language",
        "tier",
        "version",
        "urls",
        "vocab_url",
        "sha256",
        "size_bytes",
        "license",
        "min_engine_version",
        "eval_ref"
      ],
      "properties": {
        "type": {
          "const": "model"
        },
        "language": {
          "type": "string",
          "pattern": "^(lid|[a-z]{2})$"
        },
        "tier": {
          "type": "object",
          "required": [
            "name",
            "dims",
            "vocab_size",
            "quantization"
          ],
          "properties": {
            "name": {
              "enum": [
                "full",
                "fluency",
                "mini",
                "lid-176",
                "buckets"
              ]
            },
            "dims": {
              "type": "integer",
              "minimum": 1
            },
            "vocab_size": {
              "type": "integer",
              "minimum": 0
            },
            "quantization": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "version": {
          "type": "string"
        },
        "urls": {
          "type": "object",
          "required": [
            "primary",
            "mirror"
          ],
          "properties": {
            "primary": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "mirror": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Fallback URL; null when the artifact exists only as a release asset"
            }
          },
          "additionalProperties": false
        },
        "vocab_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "license": {
          "enum": [
            "CC-BY-SA-3.0",
            "MIT"
          ],
          "description": "CC-BY-SA-3.0 for the crawl-vector embeddings; MIT for fastText-made models (lid.176)"
        },
        "min_engine_version": {
          "type": "string"
        },
        "eval_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "pack": {
      "type": "object",
      "description": "Language pack (plan 113): one length-prefixed section stream (KPK1) carrying the dictionary aff+dic, the packed tier model/vocab and the buckets sibling, so a language cold-loads with one fetch. Cut by scripts/build_packs.py; the pack versions with its parts (registry release + dictionary_pin).",
      "required": [
        "type",
        "language",
        "version",
        "tier",
        "dictionary_pin",
        "urls",
        "contents",
        "sha256",
        "size_bytes",
        "licenses",
        "min_engine_version",
        "eval_ref"
      ],
      "properties": {
        "type": {
          "const": "pack"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}$"
        },
        "version": {
          "type": "string"
        },
        "tier": {
          "type": "string",
          "enum": [
            "mini",
            "fluency"
          ],
          "description": "The embedding tier the pack carries (its model + vocab sections)"
        },
        "dictionary_pin": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "The kotoshu/dictionaries commit the aff/dic sections were cut from"
        },
        "urls": {
          "type": "object",
          "required": [
            "primary",
            "mirror"
          ],
          "properties": {
            "primary": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri",
              "description": "null until a release uploads pack assets (owner decision, plan 113)"
            },
            "mirror": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "contents": {
          "type": "object",
          "required": [
            "aff",
            "dic",
            "model",
            "vocab"
          ],
          "properties": {
            "aff": {
              "$ref": "#/$defs/pack_section"
            },
            "dic": {
              "$ref": "#/$defs/pack_section"
            },
            "model": {
              "$ref": "#/$defs/pack_section"
            },
            "vocab": {
              "$ref": "#/$defs/pack_section"
            },
            "buckets": {
              "$ref": "#/$defs/pack_section"
            }
          },
          "additionalProperties": false
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the whole pack file"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "licenses": {
          "type": "object",
          "required": [
            "embeddings",
            "dictionary"
          ],
          "properties": {
            "embeddings": {
              "const": "CC-BY-SA-3.0"
            },
            "dictionary": {
              "type": "string",
              "format": "uri",
              "description": "The bundled dictionary license text (per-language file in kotoshu/dictionaries at dictionary_pin)"
            }
          },
          "additionalProperties": false
        },
        "min_engine_version": {
          "type": "string"
        },
        "eval_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "pack_section": {
      "type": "object",
      "required": [
        "tag",
        "offset",
        "length",
        "sha256"
      ],
      "properties": {
        "tag": {
          "type": "integer",
          "enum": [
            1,
            2,
            3,
            4,
            5
          ],
          "description": "1 aff, 2 dic, 3 model, 4 vocab, 5 buckets"
        },
        "offset": {
          "type": "integer",
          "minimum": 8
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the section payload - identical to the per-section footer in the pack and, for model/vocab/buckets, to the models/<lang>/tiers.json sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
