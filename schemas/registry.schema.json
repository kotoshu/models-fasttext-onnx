{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kotoshu/models-fasttext-onnx/raw/main/schemas/registry.schema.json",
  "title": "Kotoshu resource registry (Resource Spec v1)",
  "description": "Shape of registry.json, generated by scripts/build_registry.py. The spec value kotoshu.resources/v1 is frozen; content changes bump release_tag, never resource ids.",
  "type": "object",
  "required": [
    "spec",
    "registry_version",
    "generated_at",
    "release_tag",
    "resources"
  ],
  "properties": {
    "spec": {
      "const": "kotoshu.resources/v1"
    },
    "registry_version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "resources": {
      "type": "object",
      "propertyNames": {
        "pattern": "^kotoshu://models/[a-z]{2}/(full|fluency|mini)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "type",
        "language",
        "tier",
        "version",
        "urls",
        "vocab_url",
        "sha256",
        "size_bytes",
        "license",
        "min_engine_version",
        "eval_ref"
      ],
      "properties": {
        "type": {
          "const": "model"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}$"
        },
        "tier": {
          "type": "object",
          "required": [
            "name",
            "dims",
            "vocab_size",
            "quantization"
          ],
          "properties": {
            "name": {
              "enum": [
                "full",
                "fluency",
                "mini"
              ]
            },
            "dims": {
              "type": "integer",
              "minimum": 1
            },
            "vocab_size": {
              "type": "integer",
              "minimum": 0
            },
            "quantization": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "version": {
          "type": "string"
        },
        "urls": {
          "type": "object",
          "required": [
            "primary",
            "mirror"
          ],
          "properties": {
            "primary": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "mirror": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Fallback URL; null when the artifact exists only as a release asset"
            }
          },
          "additionalProperties": false
        },
        "vocab_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "license": {
          "const": "CC-BY-SA-3.0"
        },
        "min_engine_version": {
          "type": "string"
        },
        "eval_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
